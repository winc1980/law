{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/domain/**/*",
    "src/generated/document.d.ts",
    "src/server/**/*",
    "src/web/**/*",
    "scripts/*.ts",
    "scripts/*.tsx",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}

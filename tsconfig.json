{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "dist",
    "src/generated/validate-law.mjs"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}

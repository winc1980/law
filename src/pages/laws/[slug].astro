---
import Base from '../../layouts/Base.astro';
import LawBody from '../../components/LawBody';
import { laws } from '../../lib/laws';
import { toKanjiNumeral } from '../../lib/numbering';
import { toJapaneseEra } from '../../lib/era';
import { url } from '../../lib/url';
import '../../styles/law.css';

export function getStaticPaths() {
  return laws.map((entry) => ({ params: { slug: entry.slug }, props: entry }));
}

const { slug, law, chapters, chapterless, lastEffectiveDate } = Astro.props;
---

<Base title={law.title} description={`${law.title}（${law.effect}）の全文`}>
  <header class="law-header">
    <h1>{law.title}</h1>
    <p class="badges">
      <span class="badge">{law.lawType}</span>
      <span class="badge" data-effect={law.effect}>{law.effect}</span>
      {lastEffectiveDate && <span class="date">最終改正 {toJapaneseEra(lastEffectiveDate)} 施行</span>}
    </p>
    {law.preamble && <p class="preamble">{law.preamble}</p>}
    <p class="propose">
      <a href={url(`edit/${slug}/`)}>改正案をつくる</a>
      <span>編集して、プルリクエストとして提出できます。</span>
    </p>
  </header>

  <nav class="toc" aria-labelledby="toc-heading">
    <h2 id="toc-heading">目次</h2>
    <ol>
      {
        chapters.map((chapter) => (
          <li>
            <a href={`#ch-${chapter.id}`}>
              <span class="ch">第{toKanjiNumeral(chapter.number)}章</span>
              <span>{chapter.title}</span>
              <span class="range">
                第{chapter.articles[0]!.number}条
                {chapter.articles.length > 1 && `〜第${chapter.articles.at(-1)!.number}条`}
              </span>
            </a>
          </li>
        ))
      }
      {
        chapterless.map(({ article, number }) => (
          <li>
            <a href={`#art-${article.id}`}>
              <span class="ch">第{number}条</span>
              <span>{article.caption}</span>
            </a>
          </li>
        ))
      }
      {
        law.supplementaryProvisions && law.supplementaryProvisions.length > 0 && (
          <li>
            <a href="#supplementary-provisions">
              <span class="ch">附則</span>
            </a>
          </li>
        )
      }
    </ol>
  </nav>

  {/* クライアント指令を付けないので、サーバーで描いた HTML だけが出る。JS は増えない。 */}
  <LawBody law={law} anchors />
</Base>

<style>
  .law-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-family: var(--mincho);
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 0.8rem;
    text-wrap: balance;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    margin: 0;
  }

  .date {
    color: var(--ink-faint);
    font-size: 0.84rem;
  }

  .preamble {
    margin: 1.5rem 0 0;
  }

  .propose {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    margin: 1.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .propose span {
    color: var(--ink-faint);
    font-size: 0.82rem;
  }

  .toc {
    margin-bottom: 3.5rem;
    padding: 1.3rem 1.5rem;
    background: var(--panel);
  }

  .toc h2 {
    font-family: var(--mincho);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.6rem;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0 0.8rem;
    padding: 0.25rem 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .toc a:hover {
    color: var(--accent);
  }

  .toc .ch {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .toc .range {
    color: var(--ink-faint);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .toc a {
      grid-template-columns: 4.5rem 1fr;
    }

    .toc .range {
      display: none;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { laws } from '../lib/laws';
import { toJapaneseEra } from '../lib/era';
import { url } from '../lib/url';

const LAW_TYPE_ORDER = ['会則', '運営規則', '執行部決定', '執行部公示', 'その他'];

const inForce = laws.filter((e) => e.law.effect === '施行中' || e.law.effect === '施行待ち');
const others = laws.filter((e) => !inForce.includes(e));

const byType = (entries: typeof laws) =>
  [...entries].sort(
    (a, b) =>
      LAW_TYPE_ORDER.indexOf(a.law.lawType) - LAW_TYPE_ORDER.indexOf(b.law.lawType) ||
      a.slug.localeCompare(b.slug),
  );
---

<Base
  title="コンピュータ研究会・WINC 会則"
  description="コンピュータ研究会・WINC の会則および諸規則の全文"
>
  <h1>会則および諸規則</h1>
  <p class="lede">
    コンピュータ研究会・WINC の会則と諸規則の全文です。原本は JSON
    として管理されており、このページはそこから生成されています。
  </p>

  <section aria-labelledby="in-force">
    <h2 id="in-force">現行の規則</h2>
    <ul class="law-list">
      {
        byType(inForce).map((entry) => (
          <li>
            <a href={url(`laws/${entry.slug}/`)}>
              <span class="title">{entry.law.title}</span>
              <span class="badges">
                <span class="badge">{entry.law.lawType}</span>
                <span class="badge" data-effect={entry.law.effect}>
                  {entry.law.effect}
                </span>
              </span>
              <span class="meta">
                全{entry.articles.length}条
                {entry.lastEffectiveDate && ` / 最終改正 ${toJapaneseEra(entry.lastEffectiveDate)} 施行`}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    others.length > 0 && (
      <section aria-labelledby="others">
        <h2 id="others">案・廃止された規則</h2>
        <ul class="law-list">
          {byType(others).map((entry) => (
            <li>
              <a href={url(`laws/${entry.slug}/`)}>
                <span class="title">{entry.law.title}</span>
                <span class="badges">
                  <span class="badge">{entry.law.lawType}</span>
                  <span class="badge" data-effect={entry.law.effect}>
                    {entry.law.effect}
                  </span>
                </span>
                <span class="meta">全{entry.articles.length}条</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  h1 {
    font-family: var(--mincho);
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 0.9rem;
  }

  .lede {
    margin: 0 0 3rem;
    color: var(--ink-muted);
  }

  h2 {
    font-family: var(--mincho);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  section + section {
    margin-top: 3rem;
  }

  .law-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .law-list li + li {
    border-top: 1px solid var(--rule);
  }

  .law-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    padding: 1rem 0;
    color: var(--ink);
    text-decoration: none;
  }

  .law-list a:hover .title {
    color: var(--accent);
    text-decoration: underline;
  }

  .title {
    font-family: var(--mincho);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .badges {
    display: flex;
    gap: 0.4rem;
  }

  .meta {
    flex-basis: 100%;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }
</style>

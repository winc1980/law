---
import type { Article } from '../types/law';
import { toFullWidthNumeral, toKanjiNumeral } from '../lib/numbering';

interface Props {
  article: Article;
  /** 条の見出しに出す番号。「第1条」など。 */
  label: string;
}

const { article, label } = Astro.props;
const anchor = `art-${article.id}`;
---

<article class="article" id={anchor}>
  <h3 class="caption">
    （{article.caption}）
    <a class="anchor" href={`#${anchor}`} aria-label={`${article.caption}への固定リンク`}>#</a>
  </h3>

  <div class="para">
    <span class="marker">{label}</span>
    <span class="text">{article.content}</span>
  </div>

  {
    article.items && (
      <ol class="items">
        {article.items.map((item, i) => (
          <li>
            <span class="marker">{toKanjiNumeral(i + 1)}</span>
            <span class="text">{item}</span>
          </li>
        ))}
      </ol>
    )
  }

  {
    article.paragraphs?.map((paragraph, i) => (
      <>
        <div class="para">
          {/* 第1項は article.content が担うため、項番号は2から始まる */}
          <span class="marker">{toFullWidthNumeral(i + 2)}</span>
          <span class="text">{paragraph.content}</span>
        </div>
        {paragraph.items && (
          <ol class="items">
            {paragraph.items.map((item, j) => (
              <li>
                <span class="marker">{toKanjiNumeral(j + 1)}</span>
                <span class="text">{item}</span>
              </li>
            ))}
          </ol>
        )}
      </>
    ))
  }
</article>

<style>
  .article {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    scroll-margin-top: 1.5rem;
  }

  .caption {
    font-family: var(--mincho);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.7;
    margin: 0;
  }

  .anchor {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
    text-decoration: none;
    opacity: 0;
    padding-inline: 0.2em;
  }

  .article:hover .anchor,
  .anchor:focus-visible {
    opacity: 1;
  }

  .para {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.6em;
  }

  .marker {
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .text {
    /* 号の本文には定義語とその説明が改行で区切られて入ることがある */
    white-space: pre-line;
  }

  .items {
    list-style: none;
    margin: 0.15rem 0 0.25rem;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .items li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.6em;
  }
</style>

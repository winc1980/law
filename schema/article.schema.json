{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./article.schema.json",
  "title": "Article",
  "description": "条文の形式",
  "type": "object",
  "properties": {
    "id": {
      "title": "ID",
      "type": "string",
      "description": "条文の安定識別子。条番号は配列順から自動採番されるため改正で変動するが、このIDは一度付けたら変更しない。恒久リンクおよび条文間の参照に用いる。",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "caption": {
      "title": "見出し",
      "type": "string",
      "description": "条文の見出し",
      "minLength": 1
    },
    "content": {
      "title": "内容",
      "type": "string",
      "description": "条文の内容。項を分ける場合1項をここに記述し、2項以降はparagraphsに記述する。",
      "minLength": 1
    },
    "paragraphs": {
      "title": "項",
      "type": "array",
      "description": "条文の項。第1項は「内容」に書くため、ここは第2項から並べる。",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "title": "内容",
            "type": "string",
            "description": "項の内容",
            "minLength": 1
          },
          "items": {
            "title": "号",
            "type": "array",
            "description": "項の箇条書き(号)",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "title": "号",
      "type": "array",
      "description": "条文の箇条書き(号)",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "caption",
    "content"
  ],
  "additionalProperties": false
}

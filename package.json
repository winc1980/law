{
  "name": "winc-law",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "会の規則・決定のJSON原本と閲覧・編集ツール",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "generate": "bun scripts/generate.ts",
    "validate": "bun scripts/validate.ts",
    "check": "bun scripts/generate.ts --check && bunx --bun tsc --noEmit",
    "test": "bun test ./tests/unit",
    "commit": "git -c core.hooksPath=.githooks commit",
    "test:browser": "bunx --bun playwright test",
    "test:browser:webkit": "LAW_TEST_BROWSER=webkit bunx --bun playwright test",
    "build": "bun scripts/build.tsx",
    "verify": "bun run validate && bun run check && bun run test && bun run build",
    "prepare:commit": "bun scripts/prepare-commit.ts",
    "hooks:install": "bun scripts/install-hooks.ts",
    "migrate": "bun scripts/migrate.ts",
    "format": "bunx --bun prettier --write ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "diff": "8.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.9.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bun-plugin-tailwind": "0.1.2",
    "json-schema-to-typescript": "15.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}

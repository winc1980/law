{
  "name": "winc-law",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "コンピュータ研究会・WINC の会則および諸規則",
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
    "gen:validator": "node scripts/gen-validator.mjs",
    "gen": "npm run gen:types && npm run gen:validator",
    "validate": "node scripts/validate.mjs",
    "validate:strict": "node scripts/validate.mjs --strict",
    "test": "node --test scripts/test.mjs",
    "dev": "astro dev",
    "build": "npm run validate && npm run test && astro build",
    "preview": "astro preview",
    "check": "npm run validate && npm run test && astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "ajv": "^8.17.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.2"
  }
}
